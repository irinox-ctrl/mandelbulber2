							 + z.z * (temp * v.x * v.z - s * v.y);
		rotVec.y = z.x * (temp * v.x * v.y - s * v.z) + z.y * (c + temp * v.y * v.y)
							 + z.z * (temp * v.y * v.z + s * v.x);
		rotVec.z = z.x * (temp * v.x * v.z + s * v.y) + z.y * (temp * v.y * v.z - s * v.x)
