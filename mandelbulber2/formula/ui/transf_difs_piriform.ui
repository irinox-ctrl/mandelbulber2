       <widget class="MyDoubleSpinBox" name="spinbox_transf_multiplier_scale_1">
        <property name="minimum"><double>-100.0</double></property><property name="maximum"><double>100.0</double></property>
        <property name="singleStep"><double>0.01</double></property><property name="value"><double>1.0</double></property>
