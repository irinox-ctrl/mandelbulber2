     <item row="10" column="3">
            <widget class="MyDoubleSpinBox" name="spinbox_transf_multiplier_clip_curve_1"><property name="toolTip"><string>Clip transition smoothness (0-1).</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>0.000000</double></property><property name="maximum"><double>1.000000</double></property><property name="singleStep"><double>0.010000</double></property></widget>
     </item>
     <item row="10" column="4">
            <widget class="QLabel" name="label_mult_cl_knee_1"><property name="text"><string>Cl Knee</string></property></widget>
