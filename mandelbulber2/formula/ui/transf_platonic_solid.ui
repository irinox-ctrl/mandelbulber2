            <widget class="MyDoubleSpinBox" name="spinbox_transf_multiplier_harmonics_1"><property name="toolTip"><string>Add overtones to the waveform (0-5). Creates richer textures.</string></property><property name="decimals"><number>2</number></property><property name="minimum"><double>0.000000</double></property><property name="maximum"><double>5.000000</double></property><property name="singleStep"><double>0.100000</double></property></widget>
