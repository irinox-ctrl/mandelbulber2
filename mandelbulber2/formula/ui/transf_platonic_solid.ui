   <item>
    <widget class="MyGroupBox" name="groupCheck_transf_multiplier_enabled_1_false">
     <property name="title"><string>Multiplier 1</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>false</bool></property>
     <layout class="QGridLayout" name="gridLayout_mult1">
      <property name="spacing"><number>2</number></property>
      <item row="0" column="0">
       <widget class="QLabel"><property name="text"><string>Target:</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="MyComboBox" name="comboBox_transf_multiplier_mode_1">
        <item><property name="text"><string notr="true">z (all)</string></property></item>
        <item><property name="text"><string notr="true">z.x</string></property></item>
        <item><property name="text"><string notr="true">z.y</string></property></item>
        <item><property name="text"><string notr="true">z.z</string></property></item>
        <item><property name="text"><string notr="true">DE</string></property></item>
        <item><property name="text"><string notr="true">color</string></property></item>
        <item><property name="text"><string notr="true">z.w</string></property></item>
        <item><property name="text"><string notr="true">z.xy</string></property></item>
        <item><property name="text"><string notr="true">z.xz</string></property></item>
        <item><property name="text"><string notr="true">z.yz</string></property></item>
        <item><property name="text"><string notr="true">color accum</string></property></item>
       </widget>
      </item>
      <item row="0" column="2">
       <widget class="QLabel"><property name="text"><string>Value:</string></property></widget>
      </item>
      <item row="0" column="3">
       <widget class="MyDoubleSpinBox" name="spinbox_transf_multiplier_scale_1">
        <property name="minimum"><double>-100.0</double></property><property name="maximum"><double>100.0</double></property>
        <property name="singleStep"><double>0.01</double></property><property name="value"><double>1.0</double></property>
       </widget>
      </item>
      <item row="0" column="4">
       <widget class="QLabel"><property name="text"><string>Start iter:</string></property></widget>
      </item>
      <item row="0" column="5">
       <widget class="MySpinBox" name="spinboxInt_transf_multiplier_start_iter_1">
        <property name="minimum"><number>0</number></property><property name="maximum"><number>10000</number></property>
        <property name="value"><number>0</number></property>
       </widget>
      </item>
      <item row="0" column="6">
       <widget class="QLabel"><property name="text"><string>Stop iter:</string></property></widget>
      </item>
      <item row="0" column="7">
       <widget class="MySpinBox" name="spinboxInt_transf_multiplier_stop_iter_1">
        <property name="minimum"><number>0</number></property><property name="maximum"><number>10000</number></property>
        <property name="value"><number>250</number></property>
       </widget>
      </item>
     <item row="6" column="0">
            <widget class="QLabel" name="label_mult_attack_1"><property name="text"><string>Attack</string></property></widget>
     </item>
     <item row="6" column="1">
            <widget class="MyDoubleSpinBox" name="spinbox_transf_multiplier_attack_1"><property name="toolTip"><string>Fade-in speed (0-1). How quickly the multiplier reaches full strength after start.</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>0.000000</double></property><property name="maximum"><double>1.000000</double></property><property name="singleStep"><double>0.010000</double></property></widget>
     </item>
     <item row="6" column="2">
            <widget class="QLabel" name="label_mult_release_1"><property name="text"><string>Release</string></property></widget>
     </item>
     <item row="6" column="3">
            <widget class="MyDoubleSpinBox" name="spinbox_transf_multiplier_release_1"><property name="toolTip"><string>Fade-out speed (0-1). How quickly the multiplier fades before stop.</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>0.000000</double></property><property name="maximum"><double>1.000000</double></property><property name="singleStep"><double>0.010000</double></property></widget>
     </item>
