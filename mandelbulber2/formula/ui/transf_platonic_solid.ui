     </item>
     <item row="7" column="1">
            <widget class="MyDoubleSpinBox" name="spinbox_transf_multiplier_pulse_width_1"><property name="toolTip"><string>Duty cycle for square/triangle modes (0-1). 0.5 = symmetric.</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>0.000000</double></property><property name="maximum"><double>1.000000</double></property><property name="singleStep"><double>0.010000</double></property></widget>
     </item>
