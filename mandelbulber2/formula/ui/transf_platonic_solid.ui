            <widget class="QLabel" name="label_mult_feedback_1"><property name="text"><string>Feedback</string></property></widget>
     </item>
     <item row="6" column="5">
            <widget class="MyDoubleSpinBox" name="spinbox_transf_multiplier_feedback_1"><property name="toolTip"><string>Feed previous iteration output back as input (0-1).</string></property><property name="decimals"><number>3</number></property><property name="minimum"><double>0.000000</double></property><property name="maximum"><double>1.000000</double></property><property name="singleStep"><double>0.010000</double></property></widget>
     </item>
