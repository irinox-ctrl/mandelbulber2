  <property name="toolTip">
   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;This transform only works in hybrid mode, and is accessed by the program through parameter:&lt;/p&gt;&lt;p&gt;&lt;span style=&quot; font-style:italic;&quot;&gt;material_editor/color_by_numbers/auxillary_color_components/aux.color_hybrid_weight&lt;/span&gt;&lt;/p&gt;&lt;p&gt;To have complete control, have &amp;quot;Check for bailout&amp;quot; condition only enabled on this transform.&lt;/p&gt;&lt;p&gt;Required setting values will vary greatly between different types of fractals.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
