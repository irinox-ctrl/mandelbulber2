   <item>
    <widget class="MyGroupBox" name="groupCheck_transf_multiplier_enabled_2_false">
     <property name="title"><string>Multiplier 2</string></property>
     <property name="checkable"><bool>true</bool></property>
     <property name="checked"><bool>false</bool></property>
     <layout class="QGridLayout" name="gridLayout_mult2">
      <property name="spacing"><number>2</number></property>
      <item row="0" column="0">
       <widget class="QLabel"><property name="text"><string>Target:</string></property></widget>
      </item>
      <item row="0" column="1">
       <widget class="MyComboBox" name="comboBox_transf_multiplier_mode_2">
