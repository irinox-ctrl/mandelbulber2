  &lt;span style=&quot;color:#676767&quot;&gt;{&lt;/span&gt; &lt;span style=&quot;color:#2929cc&quot;&gt;// z = fold2 - fabs( fabs(z + fold) - fold2) - fabs(fold)// DarkBeam&amp;apos;s Abox mod1 fold&lt;/span&gt;
