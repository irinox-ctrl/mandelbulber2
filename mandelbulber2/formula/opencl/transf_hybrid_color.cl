								REAL td = (rng > 0.0f) ? (REAL)(aux->i - fractal->transformCommon.multiplierStartIter2) / rng : 0.0f;
								val = 1.0f + (val - 1.0f) * native_exp(-dcy * td * 5.0f);
							}
							// Exponent
							if (fractal->transformCommon.multiplierExponent2 != 1.0f)
							{
