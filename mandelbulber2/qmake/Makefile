install_sharefiles: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share || mkdir -p $(INSTALL_ROOT)/usr/share
	$(QINSTALL) /home/joeri/mandelbulber2/deploy/share/mandelbulber2 $(INSTALL_ROOT)/usr/share/mandelbulber2

uninstall_sharefiles: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/mandelbulber2
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/ 


install_formulaui: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/mandelbulber2/formula || mkdir -p $(INSTALL_ROOT)/usr/share/mandelbulber2/formula
	$(QINSTALL) /home/joeri/mandelbulber2/formula/ui $(INSTALL_ROOT)/usr/share/mandelbulber2/formula/ui

uninstall_formulaui: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/mandelbulber2/formula/ui
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/mandelbulber2/formula/ 


install_formulaimg: first FORCE
	@test -d $(INSTALL_ROOT)/usr/share/mandelbulber2/formula || mkdir -p $(INSTALL_ROOT)/usr/share/mandelbulber2/formula
	$(QINSTALL) /home/joeri/mandelbulber2/formula/img $(INSTALL_ROOT)/usr/share/mandelbulber2/formula/img

uninstall_formulaimg: FORCE
	-$(DEL_FILE) -r $(INSTALL_ROOT)/usr/share/mandelbulber2/formula/img
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/share/mandelbulber2/formula/ 


