	$(QINSTALL) /home/joeri/mandelbulber2/deploy/README $(INSTALL_ROOT)/usr/share/doc/mandelbulber2/README
	$(QINSTALL) /home/joeri/mandelbulber2/deploy/NEWS $(INSTALL_ROOT)/usr/share/doc/mandelbulber2/NEWS
	$(QINSTALL) /home/joeri/mandelbulber2/deploy/COPYING $(INSTALL_ROOT)/usr/share/doc/mandelbulber2/COPYING

