# Mandelbulber settings file
# version 2.33
# only modified parameters
[description]
Test scene for DOF auto-focus: centered Mandelbulb.
All geometry is roughly at the same distance from camera.
Expected auto-focus: ~7.0 (distance from camera to origin).
Camera is at (7, 0, 0) looking at origin.
[main_parameters]
image_width 800;
image_height 600;
camera 7 0 0;
target 0 0 0;
camera_top 0 0 1;
camera_distance_to_target 7;
fov 60;
perspective_type three_point;
mat1_is_defined true;
formula_1 1;
DOF_enabled true;
DOF_focus 6.0;
DOF_radius 10.0;
DOF_max_radius 250.0;
DOF_blur_opacity 4.0;
DOF_number_of_passes 1;
