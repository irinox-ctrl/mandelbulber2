####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/lib/qt5/plugins/designer || mkdir -p $(INSTALL_ROOT)/usr/lib/qt5/plugins/designer
	$(QINSTALL_PROGRAM) ../qmake/$(TARGET) $(INSTALL_ROOT)/usr/lib/qt5/plugins/designer/$(TARGET)
	-$(STRIP) --strip-unneeded $(INSTALL_ROOT)/usr/lib/qt5/plugins/designer/$(TARGET)

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/lib/qt5/plugins/designer/$(TARGET)
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/lib/qt5/plugins/designer/ 


install: install_target  FORCE

uninstall: uninstall_target  FORCE

FORCE:

