                <item row="1" column="1" colspan="2">
                 <widget class="MyComboBox" name="comboBox_textured_background_map_type">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Preferred" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;It determines, how texture will be mapped on background sphere&lt;/p&gt;&lt;p&gt;&lt;span style=" font-weight:600;"&gt;Equirectangular: &lt;br/&gt;&lt;/span&gt;&lt;span style=" font-weight:400;"&gt;Texture has to be created used equirectangular projection. It's the most popular format for textures dedicated for sphere mapping.&lt;br/&gt;Example:&lt;br/&gt;&lt;/span&gt;&lt;img src=":/tooltips/tooltips_images/equirectangular_bkg.jpg"/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=" font-weight:600;"&gt;Double hemisphere:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;Texture has to be created as a pair of images of hemispheres. Mapping has to be the same as &lt;span style=" font-style:italic;"&gt;Full dome projection&lt;/span&gt; (or &lt;span style=" font-style:italic;"&gt;Fish eye&lt;/span&gt;)&lt;br/&gt;Example texture with indicated axes and directions:&lt;br/&gt;&lt;img src=":/tooltips/tooltips_images/full_dome_bkg_axes.png"/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <item>
                   <property name="text">
                    <string>Equirectangular</string>
                   </property>
                  </item>
                  <item>
                   <property name="text">
                    <string>Double hemisphere</string>
                   </property>
                  </item>
                  <item>
                   <property name="text">
                    <string>Flat</string>
                   </property>
                  </item>
                 </widget>
                </item>
