                             <item row="6" column="0">
                               <widget class="QLabel" name="label_pattern_line_1_shape_aux">
                                 <property name="text">
                                   <string>Profiel extra</string>
                                 </property>
                                 <property name="toolTip">
                                   <string>Ovaal: Z-straal t.o.v. Y (1 = cirkel). Ring: halve dikte van de buis.</string>
                                 </property>
                               </widget>
                             </item>
                             <item row="6" column="1" colspan="2">
                               <widget class="MyLineEdit" name="logedit_pattern_line_trap_1_shape_aux" />
