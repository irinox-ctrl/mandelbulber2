                                     <string>Gauss (zacht)</string>
                                   </property>
                                 </item>
                                 <item>
                                   <property name="text">
                                     <string>Strak (smooth)</string>
                                   </property>
                                 </item>
                                 <item>
                                   <property name="text">
                                     <string>Hard (lineair)</string>
                                   </property>
                                 </item>
                                 <item>
                                   <property name="text">
                                     <string>Exponentieel</string>
                                   </property>
                                 </item>
                               </widget>
                             </item>
                             <item row="9" column="0">
                               <widget class="QLabel" name="label_pattern_line_2_side">
                                 <property name="text">
                                   <string>Zichtbare kant</string>
                                 </property>
                                 <property name="toolTip">
                                   <string>Omtrek: gloed aan beide zijden van de vorm (klassiek). Alleen buiten of binnen: één zijde van het oppervlak — handig om alleen de silhouet-rand te tonen.</string>
                                 </property>
                               </widget>
                             </item>
