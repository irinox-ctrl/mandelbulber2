                             </item>
                             <item row="8" column="0">
                               <widget class="QLabel" name="label_pattern_line_2_glow">
                                 <property name="text">
                                   <string>Gloed / rand</string>
                                 </property>
                                 <property name="toolTip">
                                   <string>Gloedbreedte: hoger = zachtere, bredere rand. Falloff: Gauss, smoothstep, lineair, exponentieel — bepaalt hoe snel het uitsterft (los van de 3-kleur-gradient).</string>
                                 </property>
                               </widget>
                             </item>
                             <item row="8" column="1">
                               <widget class="MyLineEdit" name="logedit_pattern_line_trap_2_glow_spread" />
                             </item>
