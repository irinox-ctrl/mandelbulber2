                                   </property>
                                 </item>
                                 <item>
                                   <property name="text">
                                     <string>Alleen buiten</string>
                                   </property>
                                 </item>
                                 <item>
                                   <property name="text">
                                     <string>Alleen binnen</string>
                                   </property>
                                 </item>
                               </widget>
                             </item>
