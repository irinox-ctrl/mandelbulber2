                       <item>
                         <widget class="QGroupBox" name="groupBox_pattern_line_trap_workflow">
                           <property name="toolTip">
                             <string>Presets: bewaar/laad alleen de patroonlijnparameters (liefst naammatig in je bestandenmap). Solo: 0 = alle lagen, 1–20 = isoleer die laag. Kopiëren: snel de instellingen van ene laag naar de andere (handig voor 2–3 varianten).</string>
                           </property>
                           <property name="title">
                             <string>Preset, solo, kopiëren</string>
                           </property>
                           <layout class="QVBoxLayout" name="verticalLayout_pattern_line_trap_workflow">
                             <property name="spacing">
                               <number>2</number>
                             </property>
                             <item>
                               <layout class="QHBoxLayout" name="horizontalLayout_pattern_solo">
                                 <item>
                                   <widget class="QLabel" name="label_pattern_line_trap_solo_layer">
                                     <property name="text">
                                       <string>Solo laag (0 = uit)</string>
                                     </property>
                                     <property name="toolTip">
                                       <string>0: alle actieve lagen in de render. 1–20: toon uitsluitend die ene lijn (snellere feedback bij tunen van één profiel).</string>
                                     </property>
                                   </widget>
                                 </item>
                                 <item>
                                   <widget class="MySpinBox" name="spinboxInt_pattern_line_trap_solo_layer">
                                     <property name="toolTip">
                                       <string>0 = alle lagen; anders enkel geselecteerde laag (1–20).</string>
                                     </property>
                                   </widget>
                                 </item>
                                 <item>
                                   <spacer name="horizontalSpacer_pattern_solo">
                                     <property name="orientation">
                                       <enum>Qt::Horizontal</enum>
