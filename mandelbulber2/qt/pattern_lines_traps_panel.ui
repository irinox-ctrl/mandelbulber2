                               <widget class="QLabel" name="label_pattern_line_2_shape_aux">
                                 <property name="text">
                                   <string>Profiel extra</string>
                                 </property>
                                 <property name="toolTip">
                                   <string>Ovaal: Z-straal t.o.v. Y (1 = cirkel). Ring: halve dikte van de buis.</string>
                                 </property>
                               </widget>
                             </item>
                             <item row="6" column="1" colspan="2">
                               <widget class="MyLineEdit" name="logedit_pattern_line_trap_2_shape_aux" />
                             </item>
                             <item row="7" column="0">
                               <widget class="QLabel" name="label_pattern_line_2_sharp_seg">
                                 <property name="text">
                                   <string>Scherpte / lengte</string>
                                 </property>
                                 <property name="toolTip">
                                   <string>Scherpte: sterkere piek (hoger = smallere gloed). Lengte: halve lijnlengte langs X (0 = oneindig). Zie ook «Gloed / rand».</string>
                                 </property>
                               </widget>
                             </item>
                             <item row="7" column="1">
                               <widget class="MyLineEdit" name="logedit_pattern_line_trap_2_falloff_sharpness" />
                             </item>
