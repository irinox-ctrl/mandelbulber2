                           </item>
                           <item>
                             <widget class="QLabel" name="label_pattern_line_traps_global_max_distance">
                               <property name="text">
                                 <string>Globale max. afstand</string>
                               </property>
                               <property name="toolTip">
                                 <string>Als &gt; 0, beperkt de gloed-afstand van ALLE lagen tot deze waarde. 0 = per laag eigen waarde gebruiken.</string>
