                                       </size>
                                     </property>
                                   </spacer>
                                 </item>
                               </layout>
                             </item>
                             <item>
                               <layout class="QHBoxLayout" name="horizontalLayout_pattern_presets">
                                 <item>
                                   <widget class="QLabel" name="label_pattern_line_trap_presets">
                                     <property name="text">
                                       <string>Preset</string>
                                     </property>
                                     <property name="toolTip">
                                       <string>Opgeslagen combinaties van alle patroonlijn-velden. Vernieuwen leest de map; Laden past toe; Save As vraagt een naam en slaat direct op.</string>
                                     </property>
                                   </widget>
                                 </item>
                                 <item>
                                   <widget class="QComboBox" name="comboBox_pattern_line_trap_presets">
                                     <property name="sizePolicy">
                                       <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                                         <horstretch>0</horstretch>
                                         <verstretch>0</verstretch>
                                       </sizepolicy>
                                     </property>
                                   </widget>
                                 </item>
                                 <item>
                                   <widget class="QPushButton" name="pushButton_pattern_line_trap_preset_refresh">
                                     <property name="text">
                                       <string>Vernieuwen</string>
                                     </property>
                                     <property name="toolTip">
                                       <string>Scant de preset-map opnieuw en vult de keuzelijst; gebruik na het toevoegen van handmatige .ini/.json bestanden.</string>
                                     </property>
                                   </widget>
                                 </item>
                                 <item>
                                   <widget class="QPushButton" name="pushButton_pattern_line_trap_preset_load">
                                     <property name="text">
                                       <string>Laden</string>
                                     </property>
                                     <property name="toolTip">
                                       <string>Laat de geselecteerde preset in alle patroonlijn-velden (inclusief alle 20 lagen) gelden.</string>
                                     </property>
                                   </widget>
                                 </item>
                                 <item>
                                   <widget class="QPushButton" name="pushButton_pattern_line_trap_preset_save">
                                     <property name="text">
                                       <string>Save As…</string>
                                     </property>
                                     <property name="toolTip">
                                       <string>Sla huidige patroonlijn-instellingen op als preset. Je typt alleen een naam; de preset wordt direct in de preset-map bewaard.</string>
                                     </property>
                                   </widget>
                                 </item>
                               </layout>
                             </item>
                             <item>
