                             <item row="7" column="0">
                               <widget class="QLabel" name="label_pattern_line_1_sharp_seg">
                                 <property name="text">
                                   <string>Scherpte / lengte</string>
                                 </property>
                                 <property name="toolTip">
                                   <string>Scherpte: sterkere piek (hoger = smallere gloed). Lengte: halve lijnlengte langs X (0 = oneindig). Zie ook «Gloed / rand».</string>
                                 </property>
                               </widget>
                             </item>
                             <item row="7" column="1">
                               <widget class="MyLineEdit" name="logedit_pattern_line_trap_1_falloff_sharpness" />
