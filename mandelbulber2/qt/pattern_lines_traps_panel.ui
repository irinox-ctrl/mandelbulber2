                               <widget class="QLabel" name="label_pattern_line_3_sharp_seg">
                                 <property name="text">
                                   <string>Scherpte / lengte</string>
                                 </property>
                                 <property name="toolTip">
                                   <string>Scherpte: sterkere piek (hoger = smallere gloed). Lengte: halve lijnlengte langs X (0 = oneindig). Zie ook «Gloed / rand».</string>
                                 </property>
                               </widget>
                             </item>
                             <item row="7" column="1">
                               <widget class="MyLineEdit" name="logedit_pattern_line_trap_3_falloff_sharpness" />
