                       </item>
                       <item>
                         <widget class="QGroupBox" name="groupBox_pattern_line_exact_placement">
                           <property name="title">
                             <string>Exacte plaatsing (camera + Z-buffer)</string>
                           </property>
                           <property name="toolTip">
                             <string>Zelfde methode als «Place light» in Mandelbulber: diepte uit de render, viewvector met FOV en camerarotatie, optioneel een stukje vóór/achter het oppervlak. Vereist een afgerende preview of beeld (Z-buffer).</string>
                           </property>
                           <layout class="QVBoxLayout" name="verticalLayout_pattern_line_exact">
                             <property name="spacing">
                               <number>6</number>
                             </property>
                             <item>
                               <widget class="QLabel" name="label_pattern_line_exact_intro">
                                 <property name="text">
                                   <string>Kies de laag en zet de groene knop op AAN. Oppervlak: klik in de render, of zonder muis: focus op het beeld, dan Enter of Spatie = midden beeld, [ en ] = offset, of: ingedrukt houden en verticaal slepen in het beeld (offset verandert direct). (t.o.v. oppervlak, zelfde idee als Alt+wiel in Effects). Zet de knop uit of een andere muisactie om te stoppen.</string>
                                 </property>
                                 <property name="wordWrap">
                                   <bool>true</bool>
                                 </property>
                               </widget>
                             </item>
                             <item>
                               <layout class="QHBoxLayout" name="horizontalLayout_pattern_line_precision">
                                 <item>
                                   <widget class="QLabel" name="label_pattern_line_precision_mode">
                                     <property name="text">
                                       <string>Plaatsing</string>
                                     </property>
                                     <property name="toolTip">
                                       <string>Offset/effect: zoals voorheen (~10% scene vanaf camera, zachte verschuiving). Nauwkeurig: midden van het pixel + bilineaire Z, handmatige afstand 0 — dichter op waar u klikt.</string>
                                     </property>
                                   </widget>
                                 </item>
                                 <item>
                                   <widget class="QComboBox" name="comboBox_pattern_line_precision_mode">
                                     <property name="sizePolicy">
                                       <sizepolicy hsizetype="MinimumExpanding" vsizetype="Fixed">
                                         <horstretch>0</horstretch>
                                         <verstretch>0</verstretch>
                                       </sizepolicy>
                                     </property>
                                     <property name="currentIndex">
                                       <number>0</number>
                                     </property>
                                     <property name="toolTip">
                                       <string>Offset/effect: zoals voorheen. Nauwkeurig: subpixel-ray + Z voor strakkere plaatsing op de klik.</string>
                                     </property>
                                     <item>
                                       <property name="text">
                                         <string>Offset / effect (zoals eerder)</string>
                                       </property>
                                     </item>
                                     <item>
                                       <property name="text">
                                         <string>Nauwkeurig (midden pixel + Z)</string>
                                       </property>
                                     </item>
                                   </widget>
                                 </item>
                               </layout>
                             </item>
                             <item>
                               <layout class="QHBoxLayout" name="horizontalLayout_pattern_line_exact">
                                 <item>
                                   <widget class="QLabel" name="label_pattern_line_exact_layer">
                                     <property name="text">
                                       <string>Laag</string>
                                     </property>
                                   </widget>
                                 </item>
                                 <item>
                                   <widget class="QSpinBox" name="spinbox_pattern_line_exact_layer">
                                     <property name="minimum">
                                       <number>1</number>
                                     </property>
                                     <property name="maximum">
                                       <number>20</number>
                                     </property>
                                     <property name="value">
                                       <number>1</number>
                                     </property>
                                     <property name="toolTip">
                                       <string>Welke patroonlijn (1–20) krijgt de nieuwe positie bij de volgende klik in het beeld.</string>
                                     </property>
                                   </widget>
                                 </item>
                                 <item>
                                   <widget class="QPushButton" name="pushButton_pattern_line_exact_activate">
                                     <property name="text">
                                       <string>Exacte klik-plaatsing (AAN / UIT)</string>
                                     </property>
                                     <property name="checkable">
                                       <bool>true</bool>
                                     </property>
                                     <property name="toolTip">
                                       <string>AAN: zelfde pipeline als hulplicht, groene knop. Klik in de render, of Enter/Spatie = midden; [ en ] of verticaal slepen in het beeld = offset. UIT: «geen» of knop. Offset: Effects, Alt+scroll, of [ ]. (Hulplicht: Alt+sleep wijzigt offset, sleep zonder Alt verplaatst het licht.)</string>
                                     </property>
                                     <property name="sizePolicy">
                                       <sizepolicy hsizetype="MinimumExpanding" vsizetype="Fixed">
                                         <horstretch>0</horstretch>
                                         <verstretch>0</verstretch>
                                       </sizepolicy>
                                     </property>
                                   </widget>
                                 </item>
                               </layout>
                             </item>
                             <item>
                               <widget class="QGroupBox" name="groupBox_pattern_line_placement_offset_xyz">
                                 <property name="title">
                                   <string>Extra positie X / Y / Z (wereld)</string>
                                 </property>
                                 <property name="toolTip">
                                   <string>Verschuiving in wereldruimte die na de klik-positie (en na de handmatige z-afstand uit Effects) wordt opgeteld. Hetzelfde als in Effects — Light placement options.</string>
                                 </property>
                                 <layout class="QGridLayout" name="gridLayout_pattern_line_placement_offset">
                                   <property name="spacing">
                                     <number>4</number>
                                   </property>
                                   <item row="0" column="0">
                                     <widget class="QLabel" name="label_pattern_line_pl_offset_x">
                                       <property name="text">
                                         <string>X</string>
                                       </property>
                                       <property name="alignment">
                                         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
                                       </property>
                                     </widget>
                                   </item>
                                   <item row="0" column="1">
                                     <widget class="MyLineEdit" name="vect3_aux_light_manual_placement_offset_x">
                                       <property name="sizePolicy">
                                         <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
                                           <horstretch>0</horstretch>
                                           <verstretch>0</verstretch>
                                         </sizepolicy>
                                       </property>
                                       <property name="minimumSize">
                                         <size>
                                           <width>80</width>
                                           <height>22</height>
                                         </size>
                                       </property>
                                       <property name="toolTip">
                                         <string>Extra X in wereldcoördinaten (zelfde parameter als in Effects/dock hulplicht).</string>
                                       </property>
                                     </widget>
                                   </item>
                                   <item row="1" column="0">
                                     <widget class="QLabel" name="label_pattern_line_pl_offset_y">
                                       <property name="text">
                                         <string>Y</string>
                                       </property>
                                       <property name="alignment">
                                         <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
                                       </property>
                                     </widget>
                                   </item>
