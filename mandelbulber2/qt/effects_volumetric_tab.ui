                <item row="3" column="0">
                 <widget class="QLabel" name="label_82">
                  <property name="text">
                   <string>Max iter. for color#1:</string>
                  </property>
                 </widget>
                </item>
                <item row="7" column="1">
                 <widget class="MyColorButton" name="colorButton_iteration_fog_color_3" native="true">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Color #3 of fog effect&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
