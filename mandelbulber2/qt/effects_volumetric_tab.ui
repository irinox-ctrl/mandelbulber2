                   <bool>true</bool>
                  </property>
                 </widget>
                </item>
                <item row="0" column="1">
                 <widget class="MyLineEdit" name="logedit_iteration_fog_opacity">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Opacity of fog. Higher value gives denser fog.&lt;br/&gt;&lt;/p&gt;&lt;table border="0" style=" margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px;" cellspacing="2" cellpadding="0"&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;opacity = 1000&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;opacity = 4000&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;opacity = 16000&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;p&gt;&lt;img src=":/tooltips/tooltips_images/image - shader - iterfog - 4 - 1000.jpg"/&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;img src=":/tooltips/tooltips_images/image - shader - iterfog - 4 - 4000.jpg"/&gt;&lt;/p&gt;&lt;/td&gt;&lt;td&gt;&lt;p&gt;&lt;img src=":/tooltips/tooltips_images/image - shader - iterfog - 4 - 16000.jpg"/&gt;&lt;/p&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="5" column="0">
                 <widget class="QLabel" name="label_84">
                  <property name="text">
                   <string>Color #1:</string>
                  </property>
                 </widget>
                </item>
                <item row="9" column="0">
                 <widget class="QLabel" name="label_74">
                  <property name="text">
                   <string>Shape from primitive:</string>
                  </property>
                 </widget>
                </item>
                <item row="9" column="1">
                 <widget class="MyComboBox" name="comboBox_iteration_fog_primitive">
                  <property name="toolTip">
                   <string>Selects the geometric primitive used to define the spatial boundaries of basic fog. The chosen shape (such as box, sphere, or other available primitives) determines where in the scene the basic fog effect will be applied, allowing for precise control over the fog’s location and extent.</string>
                  </property>
                  <item>
                   <property name="text">
                    <string>None</string>
                   </property>
                  </item>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <widget class="QPushButton" name="pushButton_autoFog_iteration">
                <property name="toolTip">
                 <string>Probe the current view and calculate optimal iteration fog parameters (trim, opacity, color thresholds). Uses fractal-type detection and percentile statistics. Adjust bias spinboxes below to fine-tune results.</string>
                </property>
                <property name="text">
                 <string>Auto Detect Iteration Fog</string>
                </property>
               </widget>
              </item>
              <item>
               <layout class="QHBoxLayout" name="horizontalLayout_autoFogScale">
                <item>
                 <widget class="QLabel" name="label_autoFogOpacityScale">
                  <property name="text">
                   <string>Auto-fog opacity scale:</string>
                  </property>
                  <property name="toolTip">
                   <string>Global multiplier applied to auto-calculated fog opacity. 1.0 = use probe result as-is.</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="MyDoubleSpinBox" name="spinbox_auto_fog_opacity_scale">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>Multiplier for auto-calculated fog opacity. Default 1.0 = use calculated value. Increase if fog is too faint, decrease if too dense.</string>
                  </property>
                  <property name="decimals">
                   <number>2</number>
                  </property>
                  <property name="minimum">
                   <double>0.01</double>
                  </property>
                  <property name="maximum">
                   <double>1000.0</double>
                  </property>
                  <property name="singleStep">
                   <double>0.1</double>
                  </property>
                  <property name="value">
                   <double>1.0</double>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout" name="horizontalLayout_autoFogTrimBias">
                <item>
                 <widget class="QLabel" name="label_autoFogTrimBias">
                  <property name="text">
                   <string>Trim bias:</string>
                  </property>
                  <property name="toolTip">
                   <string>Added to auto-calculated lower trim. Negative = fog starts at lower iterations; positive = tighter around the surface.</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="MyDoubleSpinBox" name="spinbox_auto_fog_trim_bias">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>Offset for auto-calculated trim. Negative = show more low-iteration fog. Positive = cut off more low iterations. Default 0.</string>
                  </property>
                  <property name="decimals">
                   <number>1</number>
                  </property>
                  <property name="minimum">
                   <double>-500.0</double>
                  </property>
                  <property name="maximum">
                   <double>500.0</double>
                  </property>
                  <property name="singleStep">
                   <double>0.5</double>
                  </property>
                  <property name="value">
                   <double>0.0</double>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout" name="horizontalLayout_autoFogTrimHighBias">
                <item>
                 <widget class="QLabel" name="label_autoFogTrimHighBias">
                  <property name="text">
                   <string>Trim high bias:</string>
                  </property>
                  <property name="toolTip">
                   <string>Added to auto-calculated upper trim. Controls where high-iteration fog saturates.</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="MyDoubleSpinBox" name="spinbox_auto_fog_trim_high_bias">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>Offset for auto-calculated trim high. Negative = softer fall-off. Positive = harder fall-off at high iterations. Default 0.</string>
                  </property>
                  <property name="decimals">
                   <number>1</number>
                  </property>
                  <property name="minimum">
                   <double>-2000.0</double>
                  </property>
                  <property name="maximum">
                   <double>2000.0</double>
                  </property>
                  <property name="singleStep">
                   <double>1.0</double>
                  </property>
                  <property name="value">
                   <double>0.0</double>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout" name="horizontalLayout_autoFogColorSpread">
                <item>
                 <widget class="QLabel" name="label_autoFogColorSpread">
                  <property name="text">
                   <string>Color spread:</string>
                  </property>
                  <property name="toolTip">
                   <string>Scales the spacing between iteration-fog color thresholds after auto-tuning.</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="MyDoubleSpinBox" name="spinbox_auto_fog_color_spread">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>Multiplier for color maxiter spread. &lt;1 = colors closer together, &gt;1 = colors more spread out. Default 1.0.</string>
                  </property>
                  <property name="decimals">
                   <number>2</number>
                  </property>
                  <property name="minimum">
                   <double>0.1</double>
                  </property>
                  <property name="maximum">
                   <double>2.0</double>
                  </property>
                  <property name="singleStep">
                   <double>0.1</double>
                  </property>
                  <property name="value">
                   <double>1.0</double>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QHBoxLayout" name="horizontalLayout_autoFogBoostScale">
                <item>
                 <widget class="QLabel" name="label_autoFogBoostScale">
                  <property name="text">
                   <string>Boost scale:</string>
                  </property>
                  <property name="toolTip">
                   <string>Scales the auto-calculated fog brightness boost applied to lit fog regions.</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="MyDoubleSpinBox" name="spinbox_auto_fog_boost_scale">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>Multiplier for auto-calculated brightness boost. Default 1.0 = use calculated value. Increase for brighter fog, decrease for subtler fog.</string>
                  </property>
                  <property name="decimals">
                   <number>2</number>
                  </property>
                  <property name="minimum">
                   <double>0.0</double>
                  </property>
                  <property name="maximum">
                   <double>3.0</double>
                  </property>
                  <property name="singleStep">
                   <double>0.1</double>
                  </property>
                  <property name="value">
                   <double>1.0</double>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="MyGroupBox" name="groupCheck_clouds_enable">
             <property name="toolTip">
              <string>Procedural volumetric clouds along view rays, with per-light illumination and optional shadows. &lt;b&gt;Note:&lt;/b&gt; enabling clouds in OpenCL compiles extra shader code and may trigger a kernel recompile. Use presets for safer starting values; tune density gamma and softness for edge quality.</string>
             </property>
             <property name="title">
              <string>Clouds</string>
             </property>
             <property name="checkable">
              <bool>true</bool>
             </property>
             <layout class="QVBoxLayout" name="verticalLayout_6">
              <property name="spacing">
               <number>2</number>
              </property>
              <property name="leftMargin">
               <number>2</number>
              </property>
              <property name="topMargin">
               <number>2</number>
              </property>
              <property name="rightMargin">
               <number>2</number>
              </property>
              <property name="bottomMargin">
               <number>2</number>
              </property>
              <item>
               <layout class="QHBoxLayout" name="horizontalLayout_cloudsPreset">
                <item>
                 <widget class="QLabel" name="label_clouds_preset">
                  <property name="text">
                   <string>Preset:</string>
                  </property>
                  <property name="toolTip">
                   <string>Starting styles: Soft Mist (light haze), Volumetric Clouds (balanced), Hard Fractal Smoke (sharp edges), Nebula Dust (sparse colored wisps).</string>
                  </property>
                 </widget>
                </item>
                <item>
                 <widget class="QComboBox" name="comboBox_clouds_preset">
                  <property name="toolTip">
                   <string>Cloud style presets with tuned opacity, sharpness, gamma, and softness. Select a style and click Apply — does not change your random seed.</string>
                  </property>
                  <item>
                   <property name="text">
                    <string>Soft Mist</string>
                   </property>
                  </item>
                  <item>
                   <property name="text">
                    <string>Volumetric Clouds</string>
                   </property>
                  </item>
                  <item>
                   <property name="text">
                    <string>Hard Fractal Smoke</string>
                   </property>
                  </item>
                  <item>
                   <property name="text">
                    <string>Nebula Dust</string>
                   </property>
                  </item>
                 </widget>
                </item>
                <item>
                 <widget class="QPushButton" name="pushButton_clouds_apply_preset">
                  <property name="toolTip">
                   <string>Apply the selected cloud preset to opacity, sharpness, density gamma, softness, and related parameters.</string>
                  </property>
                  <property name="text">
                   <string>Apply</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QGridLayout" name="gridLayout_19">
                <property name="bottomMargin">
                 <number>2</number>
                </property>
                <property name="spacing">
                 <number>2</number>
                </property>
                <item row="0" column="0">
                 <widget class="QLabel" name="label_124">
                  <property name="text">
                   <string>Color</string>
                  </property>
                 </widget>
                </item>
                <item row="1" column="1">
                 <widget class="MySpinBox" name="spinboxInt_clouds_noise_iterations">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Number of noise octaves used to generate cloud density. &lt;/p&gt;&lt;p&gt;Higher values add finer, more turbulent detail and richer structure, but increase computation time due to additional noise sampling. Typical useful range: 5–12. Adjust together with Cloud Period and Detail Accuracy; higher iterations with a small period produce very high-frequency features. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="minimum">
                   <number>1</number>
                  </property>
                  <property name="maximum">
                   <number>100</number>
                  </property>
                 </widget>
                </item>
                <item row="1" column="0">
                 <widget class="QLabel" name="label_110">
                  <property name="text">
                   <string>Noise iterations:</string>
                  </property>
                 </widget>
                </item>
                <item row="5" column="1">
                 <widget class="MyDoubleSpinBox" name="spinbox_clouds_density">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Base density/coverage of the volumetric cloud field (0–1). Higher values produce thicker, more continuous clouds; lower values yield sparse, broken clouds. &lt;/p&gt;&lt;p&gt;Tune together with Cloud Opacity (overall strength), Period (scale), and Noise Iterations (detail). Typical range: 0.15–0.60; 0 = clear, 1 = near-solid overcast.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="prefix">
                   <string></string>
                  </property>
                  <property name="suffix">
                   <string></string>
                  </property>
                  <property name="decimals">
                   <number>3</number>
                  </property>
                  <property name="maximum">
                   <double>1.000000000000000</double>
                  </property>
                  <property name="singleStep">
                   <double>0.001000000000000</double>
                  </property>
                 </widget>
                </item>
                <item row="6" column="0">
                 <widget class="QLabel" name="label_114">
                  <property name="text">
                   <string>Period:</string>
                  </property>
                 </widget>
                </item>
                <item row="6" column="1">
                 <widget class="MyLineEdit" name="logedit_clouds_period">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Spatial scale of the procedural cloud noise (period, in scene units). Larger values yield bigger, smoother cloud structures; smaller values create finer, more turbulent detail. &lt;/p&gt;&lt;p&gt;Interacts with Noise Iterations and Detail Accuracy; very small periods may increase render time and require higher Detail Accuracy to avoid aliasing.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="5" column="0">
                 <widget class="QLabel" name="label_113">
                  <property name="text">
                   <string>Density:</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="1">
                 <widget class="MySpinBox" name="spinboxInt_clouds_random_seed">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Random seed for the procedural noise field driving clouds. Changing it generates a different (statistically equivalent) cloud layout/phase without altering density, scale (period), or octave structure. Keep constant for deterministic, reproducible renders and animations; vary to explore alternative compositions. Integer value, typically 0–1,000,000.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="maximum">
                   <number>100000</number>
                  </property>
                 </widget>
                </item>
                <item row="7" column="1">
                 <widget class="MyDoubleSpinBox" name="spinbox_clouds_ambient_light">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Ambient light contribution for clouds (0–1). &lt;/p&gt;&lt;p&gt;Blends uniform ambient illumination into cloud lighting: &lt;/p&gt;&lt;p&gt;0 = only direct lights with full shadow contrast; &lt;/p&gt;&lt;p&gt;1 = fully ambient, very soft/flat shadows. &lt;/p&gt;&lt;p&gt;Increase to brighten interiors and soften shadows; decrease for crisper shading. &lt;/p&gt;&lt;p&gt;Does not affect opacity. &lt;/p&gt;&lt;p&gt;Typical range: 0.05–0.30.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="prefix">
                   <string></string>
                  </property>
                  <property name="suffix">
                   <string></string>
                  </property>
                  <property name="decimals">
                   <number>3</number>
                  </property>
                  <property name="maximum">
                   <double>1.000000000000000</double>
                  </property>
                  <property name="singleStep">
                   <double>0.010000000000000</double>
                  </property>
                 </widget>
                </item>
                <item row="8" column="0">
                 <widget class="QLabel" name="label_144">
                  <property name="text">
                   <string>Visible light and trap light boost:</string>
                  </property>
                  <property name="wordWrap">
                   <bool>true</bool>
                  </property>
                 </widget>
                </item>
                <item row="8" column="1">
                 <widget class="MyLineEdit" name="logedit_clouds_lights_boost">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Boosts intensity of visible light beams and orbit‑trap “fake lights” inside clouds. Scales their contribution with cloud density/opacity: higher values make light shafts brighter and more pronounced, especially in dense regions. &lt;/p&gt;&lt;p&gt;Does not affect direct/ambient light or cloud opacity. &lt;/p&gt;&lt;p&gt;0 = no boost. Typical range 0–2; use higher for strong god‑ray effects (may increase noise).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="0" column="1">
                 <widget class="MyColorButton" name="colorButton_clouds_color" native="true">
                  <property name="text" stdset="0">
                   <string>PushButton</string>
                  </property>
                 </widget>
                </item>
                <item row="3" column="0" colspan="2">
                 <widget class="QPushButton" name="pushButton_clouds_randomize">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Generates a new random seed for the procedural cloud noise, changing the cloud pattern without altering density, period, or noise iterations. &lt;/p&gt;&lt;p&gt;Click repeatedly to explore variations; keep the chosen seed fixed for reproducible renders and animations.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
                   <string>Randomize</string>
                  </property>
                 </widget>
                </item>
                <item row="4" column="0">
                 <widget class="QLabel" name="label_112">
                  <property name="text">
                   <string>Opacity:</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="0">
                 <widget class="QLabel" name="label_111">
                  <property name="text">
                   <string>Random seed:</string>
                  </property>
                 </widget>
                </item>
                <item row="4" column="1">
                 <widget class="MyLineEdit" name="logedit_clouds_opacity">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Global multiplier for volumetric cloud opacity. Typical range 0.5–5. Default 2.0. Lower = more transparent clouds.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="7" column="0">
                 <widget class="QLabel" name="label_143">
                  <property name="text">
                   <string>Ambient light:</string>
                  </property>
                 </widget>
                </item>
                <item row="9" column="0" colspan="2">
                 <widget class="MyCheckBox" name="checkBox_clouds_cast_shadows">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Enable cloud shadowing. When checked, clouds receive and cast shadows from scene lights, giving more realistic occlusion and higher contrast; this is slower. When unchecked, faster shading without shadows. Tip: raise Clouds Ambient Light to soften shadows; use Lights Boost to emphasize light shafts.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
                   <string>Receive shadows</string>
                  </property>
                 </widget>
                </item>
                <item row="10" column="0">
                 <widget class="QLabel" name="label_clouds_density_gamma">
                  <property name="text">
                   <string>Density gamma:</string>
                  </property>
                  <property name="toolTip">
                   <string>Remaps cloud density before opacity. &lt;1 = more low-density wisps; &gt;1 = punchier cores. Default 1.0.</string>
                  </property>
                 </widget>
                </item>
                <item row="10" column="1">
                 <widget class="MyDoubleSpinBox" name="spinbox_clouds_density_gamma">
                  <property name="toolTip">
                   <string>Power curve on cloud density (0.3–3.0). Lower = softer, more transparent clouds; higher = denser, more contrasty volumes.</string>
                  </property>
                  <property name="decimals">
                   <number>2</number>
                  </property>
                  <property name="minimum">
                   <double>0.300000000000000</double>
                  </property>
                  <property name="maximum">
                   <double>3.000000000000000</double>
                  </property>
                  <property name="singleStep">
                   <double>0.100000000000000</double>
                  </property>
                  <property name="value">
                   <double>1.000000000000000</double>
                  </property>
                 </widget>
                </item>
                <item row="11" column="0">
                 <widget class="QLabel" name="label_clouds_softness">
                  <property name="text">
                   <string>Density softness:</string>
                  </property>
                  <property name="toolTip">
                   <string>Smoothstep blend between empty space and full density. Higher = softer cloud edges; lower = harder transitions.</string>
                  </property>
                 </widget>
                </item>
                <item row="11" column="1">
                 <widget class="MyDoubleSpinBox" name="spinbox_clouds_softness">
                  <property name="toolTip">
                   <string>Edge softness for cloud density (0.05–1.0). Works with density gamma to control how gradual cloud boundaries appear.</string>
                  </property>
                  <property name="decimals">
                   <number>2</number>
                  </property>
                  <property name="minimum">
                   <double>0.050000000000000</double>
                  </property>
                  <property name="maximum">
                   <double>1.000000000000000</double>
                  </property>
                  <property name="singleStep">
                   <double>0.050000000000000</double>
                  </property>
                  <property name="value">
                   <double>0.400000000000000</double>
                  </property>
                 </widget>
                </item>
                <item row="12" column="0" colspan="2">
                 <widget class="MyCheckBox" name="checkBox_clouds_adaptive_detail">
                  <property name="text">
                   <string>Adaptive cloud stepping</string>
                  </property>
                  <property name="toolTip">
                   <string>Varies ray step size with local cloud density — larger steps in empty regions, smaller steps inside clouds. Faster with similar visual quality; disable for maximum uniformity at higher cost.</string>
                  </property>
                  <property name="checked">
                   <bool>true</bool>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <widget class="MyGroupBox" name="groupCheck_clouds_sharp_edges">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Enable hard‑edged clouds by sharpening the density threshold. When on, use Sharpness to control edge steepness: higher values produce crisper, thinner transitions; lower values keep edges softer. &lt;/p&gt;&lt;p&gt;Great for dramatic silhouettes and pronounced shadows. &lt;/p&gt;&lt;p&gt;May increase noise/aliasing—raise Clouds Noise Iterations or Detail Accuracy if needed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="title">
                 <string>Sharp edges</string>
                </property>
                <property name="checkable">
                 <bool>true</bool>
                </property>
                <layout class="QFormLayout" name="formLayout_2">
                 <property name="horizontalSpacing">
                  <number>2</number>
                 </property>
                 <property name="verticalSpacing">
                  <number>2</number>
                 </property>
                 <property name="leftMargin">
                  <number>2</number>
                 </property>
                 <property name="topMargin">
                  <number>2</number>
                 </property>
                 <property name="rightMargin">
                  <number>2</number>
                 </property>
                 <property name="bottomMargin">
                  <number>2</number>
                 </property>
                 <item row="0" column="0">
                  <widget class="QLabel" name="label_142">
                   <property name="text">
                    <string>Sharpness:</string>
                   </property>
                  </widget>
                 </item>
                 <item row="0" column="1">
                  <widget class="MyDoubleSpinBox" name="spinbox_clouds_sharpness">
                   <property name="sizePolicy">
                    <sizepolicy hsizetype="Expanding" vsizetype="Maximum">
                     <horstretch>0</horstretch>
                     <verstretch>0</verstretch>
                    </sizepolicy>
                   </property>
                   <property name="toolTip">
                    <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Edge steepness for Sharp edges clouds. Higher values sharpen the density threshold (crisper, thinner cloud contours); lower values keep transitions soft. &lt;/p&gt;&lt;p&gt;Very high values may introduce aliasing/noise—consider increasing Clouds Noise Iterations or Clouds Detail Accuracy.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                   </property>
                   <property name="prefix">
                    <string></string>
                   </property>
                   <property name="suffix">
                    <string></string>
                   </property>
                   <property name="decimals">
                    <number>1</number>
                   </property>
                   <property name="minimum">
                    <double>1.000000000000000</double>
                   </property>
                   <property name="maximum">
                    <double>1000000.000000000000000</double>
                   </property>
                   <property name="singleStep">
                    <double>1.000000000000000</double>
                   </property>
                   <property name="value">
                    <double>20.000000000000000</double>
                   </property>
                  </widget>
                 </item>
                </layout>
               </widget>
              </item>
              <item>
               <layout class="QGridLayout" name="gridLayout_6">
                <property name="spacing">
                 <number>2</number>
                </property>
                <item row="1" column="3">
                 <widget class="MyLineEdit" name="vect3_clouds_speed_y"></widget>
                </item>
                <item row="1" column="2">
                 <widget class="QLabel" name="label_140">
                  <property name="text">
                   <string>y</string>
                  </property>
                  <property name="alignment">
                   <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
                  </property>
                 </widget>
                </item>
                <item row="2" column="2">
                 <widget class="QLabel" name="label_141">
                  <property name="text">
                   <string>z</string>
                  </property>
                  <property name="alignment">
                   <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
                  </property>
                 </widget>
                </item>
                <item row="0" column="3">
                 <widget class="MyLineEdit" name="vect3_clouds_speed_x">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;X-axis drift speed of the clouds. Controls how fast the noise field moves along +X over time (animation). &lt;/p&gt;&lt;p&gt;Positive = moves toward +X, negative = toward −X; 0 = no motion. &lt;/p&gt;&lt;p&gt;Effective speed scales with Clouds Period. &lt;/p&gt;&lt;p&gt;Use small values (e.g., ±0.001 to ±0.05). &lt;/p&gt;&lt;p&gt;Combine with Y/Z for wind direction.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="0" column="2">
                 <widget class="QLabel" name="label_135">
                  <property name="text">
                   <string>x</string>
                  </property>
                  <property name="alignment">
                   <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
                  </property>
                 </widget>
                </item>
                <item row="2" column="3">
                 <widget class="MyLineEdit" name="vect3_clouds_speed_z"></widget>
                </item>
                <item row="1" column="1">
                 <widget class="QLabel" name="label_133">
                  <property name="text">
                   <string>Clouds movement speed:</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <layout class="QGridLayout" name="gridLayout_12">
                <property name="topMargin">
                 <number>10</number>
                </property>
                <item row="0" column="0">
                 <widget class="QLabel" name="label_145">
                  <property name="text">
                   <string>Shape from primitive:</string>
                  </property>
                 </widget>
                </item>
                <item row="0" column="1">
                 <widget class="MyComboBox" name="comboBox_clouds_primitive">
                  <property name="toolTip">
                   <string>Selects the geometric primitive used to define the spatial boundaries of basic fog. The chosen shape (such as box, sphere, or other available primitives) determines where in the scene the basic fog effect will be applied, allowing for precise control over the fog’s location and extent.</string>
                  </property>
                  <item>
                   <property name="text">
                    <string>None</string>
                   </property>
                  </item>
                 </widget>
                </item>
               </layout>
              </item>
              <item>
               <widget class="MyGroupBox" name="groupCheck_clouds_plane_shape">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Enable planar cloud layer. Constrains clouds to a band around a rotated plane with a soft vertical falloff. &lt;/p&gt;&lt;p&gt;Use Height to set layer thickness, and Center/Rotation to position and tilt the layer. &lt;/p&gt;&lt;p&gt;Useful for horizon-like cloud sheets and can speed up rendering by limiting the cloud volume.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="title">
                 <string>Plane shape</string>
                </property>
                <property name="checkable">
                 <bool>true</bool>
                </property>
                <layout class="QVBoxLayout" name="verticalLayout_7" stretch="0">
                 <property name="spacing">
                  <number>2</number>
                 </property>
                 <property name="leftMargin">
                  <number>2</number>
                 </property>
                 <property name="topMargin">
                  <number>2</number>
                 </property>
                 <property name="rightMargin">
                  <number>2</number>
                 </property>
                 <property name="bottomMargin">
                  <number>2</number>
                 </property>
                 <item>
                  <layout class="QGridLayout" name="gridLayout_20">
                   <property name="spacing">
                    <number>2</number>
                   </property>
                   <item row="4" column="1">
                    <widget class="QLabel" name="label_121">
                     <property name="text">
                      <string>alpha</string>
                     </property>
                     <property name="alignment">
