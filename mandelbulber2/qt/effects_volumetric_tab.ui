                   <item row="1" column="0" rowspan="3">
                    <widget class="QLabel" name="label_116">
                     <property name="text">
                      <string>Clouds center:</string>
                     </property>
                    </widget>
                   </item>
                   <item row="3" column="2">
                    <widget class="MyLineEdit" name="vect3_clouds_center_z">
                     <property name="toolTip">
                      <string>Vertical position (Z axis) of the center of the clouds volume relative to the fractal.</string>
                     </property>
                    </widget>
