              </property>
              <item>
               <layout class="QGridLayout" name="gridLayout_5" columnstretch="0,0">
                <property name="spacing">
                 <number>2</number>
                </property>
                <item row="1" column="1">
                 <widget class="MyLineEdit" name="logedit_aux_light_manual_placement_dist">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Controls distance from the fractal surface where the light will be placed with mouse pointer. When it's zero, the light will be set on fractal surface. A higher value moves the light towards the camera.&lt;/p&gt;&lt;p&gt;Mouse wheel + Alt, or vertical click-drag in the main render: with pattern line placement, drag changes offset live; with Place light, hold Alt and drag to change offset (without Alt, drag moves the light).&lt;/p&gt;&lt;p&gt;Extra X/Y/Z world offset: Pattern Lines → «Extra positie X / Y / Z (wereld)».&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="0" colspan="2">
                 <widget class="MyCheckBox" name="checkBox_aux_light_place_behind">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt; &lt;p&gt;When placing a light with the mouse, position it &lt;b&gt;behind&lt;/b&gt; the clicked surface (traced through the fractal). When disabled, the light is placed &lt;b&gt;in front&lt;/b&gt; of the surface at the manual placement distance.&lt;/p&gt; &lt;p&gt;Use to hide the emitter behind geometry while keeping its illumination/visible glow. Applies to the “Place light” mouse action.&lt;/p&gt; &lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
                   <string>Place light behind the object</string>
                  </property>
                 </widget>
                </item>
                <item row="1" column="0">
                 <widget class="QLabel" name="label_134">
                  <property name="text">
                   <string>Placement distance
(by mouse):</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="cLightSourcesManager" name="widget_light_sources_manager" native="true"></widget>
           </item>
           <item>
            <widget class="MyGroupBox" name="groupCheck_random_lights_group">
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;&lt;img src=":/tooltips/tooltips_images/random lights placement.png"/&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=" font-weight:600;"&gt;Random seed: &lt;/span&gt;random seed for lights distribution &lt;/p&gt;&lt;p&gt;&lt;span style=" font-weight:600;"&gt;Maximum distance from the fractal: &lt;/span&gt;random lights are placed within this distance from the fractal surface &lt;/p&gt;&lt;p&gt;&lt;span style=" font-weight:600;"&gt;Centre of distribution X, Y, Z: &lt;/span&gt;the centre point for random light distribution. To set this point by mouse pointer, select &amp;quot;Set position of centre for random lights&amp;quot; in Mouse click function combo box in Mandelbulber Render Window &lt;/p&gt;&lt;p&gt;&lt;span style=" font-weight:600;"&gt;Distribution radius of lights: &lt;/span&gt;maximum distance from Centre of distribution where lights can be placed. The random lights appear in the region that matches the condition of being both within this radius and also within the maximum distance from fractal surface.&lt;/p&gt;&lt;p&gt;If this radius is too small to generate random lights, then the program will automatically increase this radius. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
             <property name="title">
              <string>Random li&amp;ghts options</string>
             </property>
             <property name="checkable">
              <bool>true</bool>
             </property>
             <layout class="QVBoxLayout" name="verticalLayout_random_lights">
              <property name="spacing">
               <number>2</number>
              </property>
              <property name="leftMargin">
               <number>2</number>
              </property>
              <property name="topMargin">
               <number>2</number>
              </property>
              <property name="rightMargin">
               <number>2</number>
              </property>
              <property name="bottomMargin">
               <number>2</number>
              </property>
              <item>
               <layout class="QGridLayout" name="gridLayout_random_lights" columnstretch="0,0,0">
                <property name="spacing">
                 <number>2</number>
                </property>
                <item row="10" column="0">
                 <widget class="QLabel" name="label_random_lights_intensity_3">
                  <property name="text">
                   <string>Zichtbaarheid:</string>
                  </property>
                 </widget>
                </item>
                <item row="4" column="0">
                 <widget class="QLabel" name="label_random_lights_center_of_distribution">
                  <property name="text">
                   <string>Center of distribution:</string>
                  </property>
                 </widget>
                </item>
                <item row="8" column="2">
                 <widget class="MyLineEdit" name="logedit_random_lights_intensity">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Per‑light brightness for auto‑generated random lights.&lt;/p&gt;&lt;p&gt;Does not depend on “Number of random lights” — adding more lights does not auto‑scale intensity. Increase for brighter illumination; very high values can cause overexposure. Adjust together with Visibility and Size for desired look.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="2">
                 <widget class="MyLineEdit" name="logedit_random_lights_max_distance_from_fractal">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Maximum distance from the fractal surface used when placing auto-generated random lights. Only positions within this distance from the surface are accepted.&lt;/p&gt;&lt;p&gt;Lower values keep lights close to the surface; higher values allow them to float farther out. Very small values may slow placement or yield few/no lights. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="8" column="0">
                 <widget class="QLabel" name="label_random_lights_intensity">
                  <property name="text">
                   <string>Intensiteit:</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="0">
                 <widget class="QLabel" name="label_random_lights_max_distance_from_fractal">
                  <property name="text">
                   <string>Maximum distance
from fractal:</string>
                  </property>
                 </widget>
                </item>
                <item row="14" column="0">
                 <widget class="QLabel" name="label_random_lights_intensity_5">
                  <property name="text">
                   <string>Coloring type:</string>
                  </property>
                 </widget>
                </item>
                <item row="5" column="2">
                 <widget class="MyLineEdit" name="vect3_random_lights_distribution_center_y">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Center point (X/Y/Z) for placing auto-generated random lights. Lights are distributed around this point within the Distribution radius.&lt;/p&gt;&lt;p&gt;Use “Place random light center” to pick it with the mouse. Works together with “Maximum distance from fractal” to keep lights near the surface.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="15" column="0">
                 <widget class="QLabel" name="label_random_lights_first_color">
                  <property name="text">
                   <string>First color:</string>
                  </property>
                 </widget>
                </item>
                <item row="9" column="0">
                 <widget class="QLabel" name="label_random_lights_intensity_2">
                  <property name="text">
                   <string>Grootte:</string>
                  </property>
                 </widget>
                </item>
                <item row="11" column="0">
                 <widget class="QLabel" name="label_random_lights_intensity_4">
                  <property name="text">
                   <string>Soft shadow cone:</string>
                  </property>
                 </widget>
                </item>
                <item row="1" column="0">
                 <widget class="QLabel" name="label_random_lights_random_seed">
                  <property name="text">
                   <string>Random Seed:</string>
                  </property>
                 </widget>
                </item>
                <item row="14" column="2">
                 <widget class="MyComboBox" name="comboBox_random_lights_coloring_type">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Choose how auto‑generated random lights are colored.&lt;/p&gt;&lt;p&gt;&lt;span style=" font-style:italic;"&gt;Random colors&lt;/span&gt; — each light gets a random color.&lt;/p&gt;&lt;p&gt;&lt;span style=" font-style:italic;"&gt;Single color&lt;/span&gt; — all lights use the First color.&lt;/p&gt;&lt;p&gt;&lt;span style=" font-style:italic;"&gt;Two colors&lt;/span&gt; — each light randomly uses the First or Second color.&lt;/p&gt;&lt;p&gt;&lt;span style=" font-style:italic;"&gt;Two colors based on distance&lt;/span&gt; — color blends between First and Second color based on the light’s distance to the fractal surface (closer → First, farther → Second).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <item>
                   <property name="text">
                    <string>Random colors</string>
                   </property>
                  </item>
                  <item>
                   <property name="text">
                    <string>Single color</string>
                   </property>
                  </item>
                  <item>
                   <property name="text">
                    <string>Two colors</string>
                   </property>
                  </item>
                  <item>
                   <property name="text">
                    <string>Two colors based on distance</string>
                   </property>
                  </item>
                 </widget>
                </item>
                <item row="0" column="1" colspan="2">
                 <widget class="MySpinBox" name="spinboxInt_random_lights_number">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Number of auto-generated random lights. &lt;/p&gt;&lt;p&gt;Lights are placed around the Center of distribution within the Distribution radius, constrained by Maximum distance from fractal, and initialized using the Random seed. &lt;/p&gt;&lt;p&gt;Higher values may slow rendering and clutter the scene.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="maximum">
                   <number>999999</number>
                  </property>
                 </widget>
                </item>
                <item row="1" column="1" colspan="2">
                 <widget class="MySpinBox" name="spinboxInt_random_lights_random_seed">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Random seed for generating auto-created lights. With the same seed and settings, the random lights’ positions/colors are reproducible; change it to get a different arrangement.&lt;/p&gt;&lt;p&gt;Integer 0–999999. Does not change the number of lights, only their randomized outcome.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="maximum">
                   <number>999999</number>
                  </property>
                 </widget>
                </item>
                <item row="5" column="1">
                 <widget class="QLabel" name="label_distribution_y">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Maximum" vsizetype="Preferred">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="text">
                   <string>y:</string>
                  </property>
                 </widget>
                </item>
                <item row="12" column="0" colspan="3">
                 <widget class="MyCheckBox" name="checkBox_random_lights_cast_shadows">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Enable shadow casting for auto‑generated random lights.&lt;/p&gt;&lt;p&gt;When on, these lights occlude geometry and produce shadows. Turn off to use them as non‑shadowing fill lights and speed up rendering. For soft, blurry shadows, also enable “Calculate MC soft shadows” and adjust “Soft shadow cone”. Otherwise shadows are hard.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
                   <string>Cast shadows</string>
                  </property>
                 </widget>
                </item>
                <item row="6" column="1">
                 <widget class="QLabel" name="label_distribution_z">
