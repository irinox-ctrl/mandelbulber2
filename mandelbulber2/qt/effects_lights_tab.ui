                   </sizepolicy>
                  </property>
                  <property name="text">
                   <string>z:</string>
                  </property>
                 </widget>
                </item>
                <item row="0" column="0">
                 <widget class="QLabel" name="label_random_lights_number">
                  <property name="text">
                   <string>Number of random
lights:</string>
                  </property>
                 </widget>
                </item>
                <item row="7" column="0" colspan="3">
                 <widget class="QPushButton" name="pushButton_place_random_lights_by_mouse">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Pick the center for auto-generated random lights by clicking in the image.&lt;/p&gt;&lt;p&gt;Sets the mouse mode to “Place random light center”. On click, it also auto-sets Distribution radius to 50% and Maximum distance from fractal to 10% of the distance from the chosen center to the camera.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
                   <string>Place random light center by mouse</string>
                  </property>
                 </widget>
                </item>
                <item row="16" column="0">
                 <widget class="QLabel" name="label_random_lights_second_color">
                  <property name="text">
                   <string>Second color:</string>
                  </property>
                 </widget>
                </item>
                <item row="3" column="2">
                 <widget class="MyLineEdit" name="logedit_random_lights_distribution_radius">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Radius of the area around the Center of distribution where auto-generated random lights are placed (±radius along X/Y/Z).&lt;/p&gt;&lt;p&gt;Increase to spread lights wider; decrease to cluster them near the center. Works with “Maximum distance from fractal” to keep lights near the surface. &lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="4" column="2">
                 <widget class="MyLineEdit" name="vect3_random_lights_distribution_center_x">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Center point (X/Y/Z) for placing auto-generated random lights. Lights are distributed around this point within the Distribution radius.&lt;/p&gt;&lt;p&gt;Use “Place random light center” to pick it with the mouse. Works together with “Maximum distance from fractal” to keep lights near the surface.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="3" column="0">
                 <widget class="QLabel" name="label_random_lights_distribution_radius">
                  <property name="text">
                   <string>Distribution radius
of lights:</string>
                  </property>
                 </widget>
                </item>
                <item row="6" column="2">
                 <widget class="MyLineEdit" name="vect3_random_lights_distribution_center_z">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Center point (X/Y/Z) for placing auto-generated random lights. Lights are distributed around this point within the Distribution radius.&lt;/p&gt;&lt;p&gt;Use “Place random light center” to pick it with the mouse. Works together with “Maximum distance from fractal” to keep lights near the surface.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="4" column="1">
                 <widget class="QLabel" name="label_distribution_x">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Maximum" vsizetype="Preferred">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="text">
                   <string>x:</string>
                  </property>
                 </widget>
                </item>
                <item row="11" column="2">
                 <widget class="MyLineEdit" name="logedit_random_lights_soft_shadow_cone">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Soft shadow cone angle for auto‑generated random lights (degrees).&lt;/p&gt;&lt;p&gt;Sets the angular radius used by Monte Carlo soft‑shadow sampling. 0 = hard, crisp shadows; higher values produce softer, blurrier shadows.&lt;/p&gt;&lt;p&gt;Effective when “Cast shadows” is on, and “Calculate MC soft shadows” is enabled.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="13" column="0" colspan="3">
                 <widget class="MyCheckBox" name="checkBox_random_lights_penetrating">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Allow auto‑generated random lights to penetrate geometry.&lt;/p&gt;&lt;p&gt;When enabled, these lights are partally blocked by objects and can illuminate through walls or inside cavities—useful as fill lights. For realistic, blocked lighting and shadows, turn this off.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text">
                   <string>Penetrating</string>
                  </property>
                 </widget>
                </item>
                <item row="9" column="2">
                 <widget class="MyLineEdit" name="logedit_random_lights_size">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Emitter size (radius) of each auto‑generated random light.&lt;/p&gt;&lt;p&gt;Larger values behave more like area lights, producing softer shadows and broader highlights; smaller values approach point lights with sharper shadows. Very large sizes can flatten contrast.&lt;/p&gt;&lt;p&gt;Effective when “Random lights group” is enabled. Default: 0.1.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="10" column="2">
                 <widget class="MyLineEdit" name="logedit_random_lights_visibility">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Brightness of the visible light source (glow/halo) for each auto‑generated random light.&lt;/p&gt;&lt;p&gt;Affects only how strongly the emitter itself is drawn on screen; it does not change scene illumination (use “Intensity” for that). Works together with “Size” to define the halo’s radius. Not used for directional lights.&lt;/p&gt;&lt;p&gt;Higher values make brighter, more noticeable bulbs.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="16" column="2">
                 <widget class="MyColorButton" name="colorButton_random_lights_color_2" native="true">
                  <property name="text" stdset="0">
