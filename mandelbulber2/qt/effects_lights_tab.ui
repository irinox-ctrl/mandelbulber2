               <number>2</number>
              </property>
              <item>
               <layout class="QGridLayout" name="gridLayout">
                <property name="topMargin">
                 <number>0</number>
                </property>
                <item row="1" column="1">
                 <widget class="MyLineEdit" name="logedit_all_lights_intensity">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Global intensity multiplier for all lights (Light #1…#N). Multiplies each light’s Intensity value: 1.0 = no change, 0 = lights off, &amp;gt;1 brightens, &amp;lt;1 dims. &lt;/p&gt;&lt;p&gt;Useful for balancing overall lighting without editing each light.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="3" column="1">
                 <widget class="MyLineEdit" name="logedit_all_lights_size">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Global size multiplier for all lights’ visible glow/halo. Multiplies each light’s Size value: 1.0 = no change; &amp;gt;1 enlarges halos, &amp;lt;1 shrinks them. &lt;/p&gt;&lt;p&gt;Also scales the apparent angular size for directional lights.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="0" column="1">
                 <widget class="MyColorButton" name="colorButton_fill_light_color" native="true">
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Color of light source&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                  <property name="text" stdset="0">
                   <string>PushButton</string>
                  </property>
                 </widget>
                </item>
                <item row="1" column="0">
                 <widget class="QLabel" name="label_2">
                  <property name="text">
                   <string>All lights intensity</string>
                  </property>
                 </widget>
                </item>
                <item row="3" column="0">
                 <widget class="QLabel" name="label_4">
                  <property name="text">
                   <string>All lights size</string>
                  </property>
                 </widget>
                </item>
                <item row="4" column="1">
                 <widget class="MyLineEdit" name="logedit_rayleigh_scattering_blue">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Strength of blue Rayleigh scattering for volumetric effects (atmosphere). &lt;/p&gt;&lt;p&gt;Higher values add a blue, angle‑dependent tint around lights (∝ 1 + cos²θ). Set to 0 to disable. &lt;/p&gt;&lt;p&gt;Use with Rayleigh scattering red to balance the effect.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="1">
                 <widget class="MyLineEdit" name="logedit_all_lights_visibility">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Global multiplier for all lights’ Visibility (the visible glow/illuminated fog around lights). &lt;/p&gt;&lt;p&gt;Multiplies each light’s Visibility value: 1.0 = no change, 0 = hide visible lights, &amp;gt;1 increases glow.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
                <item row="2" column="0">
                 <widget class="QLabel" name="label_3">
                  <property name="text">
                   <string>All lights visibility</string>
                  </property>
                 </widget>
                </item>
                <item row="0" column="0">
                 <widget class="QLabel" name="label">
                  <property name="text">
                   <string>Fill light color:</string>
                  </property>
                 </widget>
                </item>
                <item row="4" column="0">
                 <widget class="QLabel" name="label_7">
                  <property name="text">
                   <string>Rayleigh scattering blue:</string>
                  </property>
                 </widget>
                </item>
                <item row="5" column="0">
                 <widget class="QLabel" name="label_13">
                  <property name="text">
                   <string>Rayleigh scattering red:</string>
                  </property>
                 </widget>
                </item>
                <item row="5" column="1">
                 <widget class="MyLineEdit" name="logedit_rayleigh_scattering_red">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Expanding" vsizetype="Maximum">
                    <horstretch>0</horstretch>
                    <verstretch>0</verstretch>
                   </sizepolicy>
                  </property>
                  <property name="toolTip">
                   <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Strength of red Mie scattering for volumetric effects (atmosphere). Increases warm, forward‑scattering glow when looking toward the light direction (stronger near beams/god‑rays). &lt;/p&gt;&lt;p&gt;1.0 = noticeable effect; 0 = off. &lt;/p&gt;&lt;p&gt;Use together with Rayleigh scattering blue to balance overall color.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                  </property>
                 </widget>
                </item>
               </layout>
              </item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QGroupBox" name="groupBox_8">
             <property name="title">
              <string>Light placement options</string>
             </property>
             <layout class="QVBoxLayout" name="verticalLayout_17">
              <property name="spacing">
               <number>2</number>
              </property>
              <property name="leftMargin">
