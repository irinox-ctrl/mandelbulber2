          <property name="text">
           <string>Alpha soft edge</string>
          </property>
         </widget>
        </item>
        <item row="6" column="1">
         <widget class="MyLineEdit" name="logedit_alpha_texture_soft_edge">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Soft edge feather width for alpha mask texture. 0.0 = hard edges, 0.5 = maximum soft fade. Only applies in Clamp mode.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
         </widget>
        </item>
