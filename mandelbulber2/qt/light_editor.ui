          </property>
         </widget>
        </item>
        <item row="4" column="1">
         <widget class="MyLineEdit" name="logedit_alpha_texture_rotation_z">
          <property name="toolTip">
           <string>Rotation of the alpha mask texture around the light direction axis in degrees.</string>
          </property>
         </widget>
        </item>
        <item row="5" column="0">
         <widget class="QLabel" name="label_alpha_repeat_mode">
          <property name="text">
