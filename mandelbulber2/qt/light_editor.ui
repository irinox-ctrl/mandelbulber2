          </property>
         </widget>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="label_alpha_scale_x">
          <property name="text">
           <string>Alpha scale X</string>
          </property>
         </widget>
        </item>
        <item row="2" column="1">
         <widget class="MyLineEdit" name="logedit_alpha_texture_scale_x">
          <property name="toolTip">
           <string>Horizontal scale of the alpha mask texture. 1.0 = original size.</string>
          </property>
         </widget>
        </item>
        <item row="3" column="0">
         <widget class="QLabel" name="label_alpha_scale_y">
          <property name="text">
           <string>Alpha scale Y</string>
          </property>
