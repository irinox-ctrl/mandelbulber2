        </item>
        <item row="3" column="1">
         <widget class="MyLineEdit" name="logedit_alpha_texture_scale_y">
          <property name="toolTip">
           <string>Vertical scale of the alpha mask texture. 1.0 = original size.</string>
          </property>
         </widget>
        </item>
        <item row="4" column="0">
