            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="text">
           <string>Texture rotation Y</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item row="11" column="1">
         <widget class="MyLineEdit" name="logedit_projection_texture_rotation_y">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Rotation of the projected texture around the light top axis (yaw) in degrees.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
         </widget>
        </item>
        <item row="12" column="0">
         <widget class="QLabel" name="label_texture_rotation_z">
          <property name="sizePolicy">
           <sizepolicy hsizetype="Maximum" vsizetype="Preferred">
            <horstretch>0</horstretch>
            <verstretch>0</verstretch>
           </sizepolicy>
          </property>
          <property name="text">
           <string>Texture rotation Z</string>
          </property>
          <property name="wordWrap">
           <bool>true</bool>
          </property>
         </widget>
        </item>
        <item row="12" column="1">
         <widget class="MyLineEdit" name="logedit_projection_texture_rotation_z">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Rotation of the projected texture around the light direction axis (roll) in degrees.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
         </widget>
        </item>
        <item row="13" column="0" colspan="2">
         <widget class="MyCheckBox" name="checkBox_projection_use_as_mask">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Use texture as intensity mask instead of color. Light color is preserved; texture brightness controls intensity.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Use texture as mask</string>
          </property>
         </widget>
        </item>
        <item row="14" column="0" colspan="2">
         <widget class="MyCheckBox" name="checkBox_projection_use_alpha_as_mask">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Use texture alpha channel as intensity mask instead of color. Requires a PNG or image with alpha channel.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Use texture alpha as mask</string>
          </property>
         </widget>
        </item>
        <item row="15" column="0" colspan="2">
         <widget class="MyCheckBox" name="checkBox_projection_use_texture_alpha_as_mask">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Use a separate alpha mask texture to control projection light visibility. The alpha mask path must be set above.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Use separate alpha mask texture</string>
          </property>
         </widget>
        </item>
        <item row="16" column="0" colspan="2">
         <widget class="MyCheckBox" name="checkBox_projection_invert_alpha_mask">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Invert the alpha mask. Black areas become fully lit and white areas become dark.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <property name="text">
           <string>Invert alpha mask</string>
          </property>
         </widget>
        </item>
        <item row="17" column="0">
         <widget class="QLabel" name="label_projection_intensity">
          <property name="text">
           <string>Projection intensity</string>
          </property>
         </widget>
        </item>
        <item row="17" column="1">
         <widget class="MyLineEdit" name="logedit_projection_intensity">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Intensity multiplier for the projection light. 1.0 = normal brightness, 0.0 = off, higher values make the projection brighter.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
         </widget>
        </item>
        <item row="18" column="0">
         <widget class="QLabel" name="label_projection_blend_mode">
          <property name="text">
           <string>Blend mode</string>
          </property>
         </widget>
        </item>
        <item row="18" column="1">
         <widget class="MyComboBox" name="comboBox_projection_blend_mode">
          <property name="toolTip">
           <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Blend mode for projection texture with light color. Multiply = texture tints the light (default). Add = texture adds to light. Screen = soft addition. Overlay = contrast boosting.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
          </property>
          <item>
           <property name="text">
            <string>Multiply</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Add</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Screen</string>
           </property>
          </item>
          <item>
           <property name="text">
            <string>Overlay</string>
           </property>
          </item>
         </widget>
        </item>
       </layout>
      </item>
