double r2d = sqrt(z.x*z.x+z.y*z.y); double star_n = fmax(floor(fabs(ta)*5+3),3.0); double phi = atan2(z.y,z.x); double star_R = tb*(1.0+tc*cos(star_n*phi)); double d = fabs(r2d-star_R)+fabs(z.z)*td; aux.DE *= (1.0 + tf*exp(-d*5.0));
