// TYPE_ID: 53
// NAME: Type 53
// PARAMS: locals
// SYSTEM: torus
double phi = atan2(z.y,z.x); double r2d = sqrt(z.x*z.x+z.y*z.y); double cinquefoil_r = ta*(2.0+cos(5.0*phi)); double cinquefoil_z = ta*sin(5.0*phi); double d = sqrt((r2d-cinquefoil_r)*(r2d-cinquefoil_r)+(z.z-cinquefoil_z)*(z.z-cinquefoil_z)); aux.DE *= (1.0 + tf*exp(-tb*d));
