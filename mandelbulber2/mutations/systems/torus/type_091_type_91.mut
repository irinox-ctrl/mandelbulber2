// NAME: Type 91
// PARAMS: locals
// SYSTEM: torus
double r2d = sqrt(z.x*z.x+z.y*z.y); double phi = atan2(z.y,z.x); double bifurcation = ta*sin(tb*phi)*sin(tc*phi*2.0); double torus_d = sqrt((r2d-td-bifurcation)*(r2d-td-bifurcation)+z.z*z.z)-0.3; aux.DE *= (1.0 + tf*exp(-torus_d*torus_d*5.0));
