double r2d = sqrt(z.x*z.x+z.y*z.y); double phi = atan2(z.y,z.x); double wave1 = sin(ta*phi + tb*z.z); double wave2 = sin(tc*phi - tb*z.z); double interference = (wave1+wave2)*(wave1+wave2)*0.25; aux.DE *= (1.0 + tf*interference*td);
