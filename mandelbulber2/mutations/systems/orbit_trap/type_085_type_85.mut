// SYSTEM: orbit_trap
double r=sqrt(z.x*z.x+z.y*z.y+z.z*z.z); double ph=atan2(z.y,z.x); double th=acos(z.z/fmax(r,1e-21)); int nph=(int)fmax(2,oa*4); int nth=(int)fmax(2,ob*4); double dph=fabs(sin(nph*ph*0.5)); double dth=fabs(sin(nth*th*0.5)); double d=r*dph*dth; aux.DE *= (1.0 + of*exp(-od*d));
