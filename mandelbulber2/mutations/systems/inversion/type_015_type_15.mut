// TYPE_ID: 15
// NAME: Type 15
// PARAMS: PA
// SYSTEM: inversion
CVector3 centers[4]; centers[0]=CVector3(PA,0,0); centers[1]=CVector3(-PA,0,0); centers[2]=CVector3(0,PA,0); centers[3]=CVector3(0,0,PA); double minD=1e20; int nearest=0; for(int k=0;k<4;k++){double d=(zz-centers[k]).Dot(zz-centers[k]); if(d<minD){minD=d;nearest=k;}} if(minD<1e-21)minD=1e-21; mde=iR*iR/minD; zz=centers[nearest]+(zz-centers[nearest])*mde;
