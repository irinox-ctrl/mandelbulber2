// TYPE_ID: 52
// NAME: Type 52
// PARAMS: locals
// SYSTEM: sym_kal
{ double ph2=atan2(zy,zx); double th=acos(zz2/r); double n=fmax(1.0,sa); double sp=2.0*M_PI/n; ph2=fmod(ph2+10.0*M_PI,sp)-sp*0.5; double m=fmax(1.0,sb); double st=M_PI/m; th=fmod(th+10.0*M_PI,st); z.x=r*sin(th)*cos(ph2); z.y=r*sin(th)*sin(ph2); z.z=r*cos(th); }
