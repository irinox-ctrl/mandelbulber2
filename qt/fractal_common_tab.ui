                       </widget>
                      </item>
                     </layout>
                    </item>
                    <item>
                     <layout class="QHBoxLayout" name="layout_sweep_range">
                      <item>
                       <widget class="QLabel" name="label_sweep_from">
                        <property name="text"><string>From:</string></property>
                       </widget>
                      </item>
                      <item>
                       <widget class="QDoubleSpinBox" name="spinBox_julia_sweep_from">
                        <property name="minimum"><double>-10.000000</double></property>
                        <property name="maximum"><double>10.000000</double></property>
                        <property name="value"><double>-2.000000</double></property>
