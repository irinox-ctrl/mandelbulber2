                   <property name="title"><string>Animated Sweep</string></property>
                   <layout class="QVBoxLayout" name="layout_julia_sweep">
                    <property name="spacing"><number>2</number></property>
                    <property name="leftMargin"><number>2</number></property>
                    <property name="topMargin"><number>2</number></property>
                    <property name="rightMargin"><number>2</number></property>
                    <property name="bottomMargin"><number>2</number></property>
                    <item>
                     <layout class="QHBoxLayout" name="layout_sweep_axis">
                      <item>
                       <widget class="QLabel" name="label_sweep_axis">
                        <property name="text"><string>Sweep axis:</string></property>
                       </widget>
                      </item>
                      <item>
                       <widget class="QComboBox" name="comboBox_julia_sweep_axis">
                        <item><property name="text"><string>c.x</string></property></item>
                        <item><property name="text"><string>c.y</string></property></item>
                        <item><property name="text"><string>c.z</string></property></item>
