                 </sizepolicy>
                </property>
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt; &lt;p&gt;Assign a material to the current fractal/formula.&lt;/p&gt; &lt;p&gt;The material defines the surface appearance during rendering (color, shading, reflectance, roughness, transparency, textures, emission, etc.).&lt;/p&gt; &lt;p&gt;How to use: - Click the material thumbnail/name to open the Material manager. - Choose an existing material or edit it; the label shows the material name and ID [matN].&lt;/p&gt; &lt;p&gt;Scope: - Applies to this fractal only; in hybrid/boolean setups each fractal can have its own material and the final look depends on how they are combined.&lt;/p&gt; &lt;/body&gt;&lt;/html&gt;</string>
                </property>
               </widget>
              </item>
             </layout>
            </widget>
