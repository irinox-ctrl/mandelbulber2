<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>cFakeLightsPanel</class>
 <widget class="QWidget" name="cFakeLightsPanel">
  <layout class="QVBoxLayout" name="verticalLayout_fake_lights_panel_root">
   <property name="leftMargin"><number>0</number></property>
   <property name="topMargin"><number>0</number></property>
   <property name="rightMargin"><number>0</number></property>
   <property name="bottomMargin"><number>0</number></property>
              <item>
               <widget class="MyGroupBox" name="groupCheck_fake_lights_enabled">
                <property name="toolTip">
                 <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Simulates a large amount of lights and is relatively fast to render.&lt;/p&gt;&lt;p&gt;An orbit trap is a point, a 2D, or 3D shape defined in 3D space. The brightness of the point is dependent on how close the point's orbit gets to the orbit trap shape during the chosen iterations.&lt;/p&gt;&lt;p&gt;This effect is difficult to setup and often you need to try many different orbit trap settings.&lt;/p&gt;&lt;p&gt;These light sources illuminate the fractal surface, but do not cast shadows.&lt;/p&gt;&lt;p&gt;Example:&lt;/p&gt;&lt;p&gt;&lt;img src=":/tooltips/tooltips_images/image - shader - orbit trap lights.jpg"/&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                </property>
                <property name="title">
                 <string>Orbit &amp;trap lights</string>
                </property>
                <property name="checkable">
                 <bool>true</bool>
                </property>
                <layout class="QVBoxLayout" name="verticalLayout_39">
                 <property name="spacing">
                  <number>2</number>
                 </property>
                 <property name="leftMargin">
                  <number>2</number>
                 </property>
                 <property name="topMargin">
                  <number>2</number>
                 </property>
                 <property name="rightMargin">
                  <number>2</number>
                 </property>
                 <property name="bottomMargin">
                  <number>2</number>
                 </property>
                 <item>
                  <layout class="QGridLayout" name="gridLayout_17" columnstretch="0,0,0">
                   <property name="spacing">
                    <number>2</number>
                   </property>
                   <item row="7" column="0" colspan="3">
                    <widget class="MyCheckBox" name="checkBox_fake_lights_relative_center">
                     <property name="sizePolicy">
                      <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                       <horstretch>0</horstretch>
                       <verstretch>0</verstretch>
                      </sizepolicy>
                     </property>
                     <property name="toolTip">
                      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Interpret the Orbit trap center relative to the fractal’s origin.&lt;/p&gt;&lt;p&gt;When enabled, the orbit‑trap distance is computed using coordinates relative to the fractal start/constant (z − C), effectively anchoring the trap to the fractal’s local origin. When disabled, the distance uses absolute coordinates (z), so the trap center is in world space.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                     </property>
                     <property name="text">
                      <string>Orbit trap center relative to the origin</string>
                     </property>
                    </widget>
                   </item>
                   <item row="0" column="0">
                    <widget class="QLabel" name="label_60">
                     <property name="text">
                      <string>Minimum iteration:</string>
                     </property>
                    </widget>
                   </item>
                   <item row="11" column="2">
                    <widget class="MyLineEdit" name="logedit_fake_lights_orbit_trap_size">
                     <property name="toolTip">
                      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Size of the Orbit trap shape used by Fake lights.&lt;/p&gt;&lt;p&gt;Meaning depends on Shape: - Point: sphere radius around the point - Line: cylinder radius around the line - Circle: ring radius - Square: half edge length - Sphere: shell radius - Cube: half edge length&lt;/p&gt;&lt;p&gt;Applied in the trap’s local space around the Orbit trap center. Use “Thickness” to control the shell’s falloff width.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                     </property>
                    </widget>
                   </item>
                   <item row="1" column="0">
                    <widget class="QLabel" name="label_91">
                     <property name="text">
                      <string>Maximum iteration:</string>
                     </property>
                    </widget>
                   </item>
                   <item row="9" column="2">
                    <widget class="MyLineEdit" name="vect3_fake_lights_orbit_trap_y">
                     <property name="toolTip">
                      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Position of orbit trap point&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                     </property>
                    </widget>
                   </item>
                   <item row="10" column="2">
                    <widget class="MyLineEdit" name="vect3_fake_lights_orbit_trap_z">
                     <property name="toolTip">
                      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Position of orbit trap point&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                     </property>
                    </widget>
                   </item>
                   <item row="0" column="2">
                    <widget class="MySpinBox" name="spinboxInt_fake_lights_min_iter">
                     <property name="sizePolicy">
                      <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
                       <horstretch>0</horstretch>
                       <verstretch>0</verstretch>
                      </sizepolicy>
                     </property>
                     <property name="toolTip">
                      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;First iteration taken for orbit trap calculation&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                     </property>
                     <property name="maximum">
                      <number>500</number>
                     </property>
                    </widget>
                   </item>
                   <item row="12" column="1">
                    <widget class="QLabel" name="label_106">
                     <property name="sizePolicy">
                      <sizepolicy hsizetype="Maximum" vsizetype="Preferred">
                       <horstretch>0</horstretch>
                       <verstretch>0</verstretch>
                      </sizepolicy>
                     </property>
                     <property name="text">
                      <string>x:</string>
                     </property>
                     <property name="alignment">
                      <set>Qt::AlignRight|Qt::AlignTrailing|Qt::AlignVCenter</set>
                     </property>
                    </widget>
                   </item>
                   <item row="11" column="0">
                    <widget class="QLabel" name="label_105">
                     <property name="text">
                      <string>Shape size:</string>
                     </property>
                    </widget>
                   </item>
                   <item row="5" column="2">
                    <widget class="MyLineEdit" name="logedit_fake_lights_thickness">
                     <property name="toolTip">
                      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Brightness of visible lights&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
                     </property>
                    </widget>
                   </item>
                   <item row="6" column="2">
                    <widget class="MyComboBox" name="comboBox_fake_lights_orbit_trap_shape">
                     <property name="toolTip">
                      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt; &lt;p&gt;Select the orbit‑trap shape used by Fake lights (lighting is driven by the distance to this shape).&lt;/p&gt; &lt;p&gt;&lt;i&gt;Point&lt;/i&gt; — a single point source near the trap center (default).&lt;/p&gt; &lt;p&gt;&lt;i&gt;Line&lt;/i&gt; — an infinite line through the center; use Orbit rotation to set its direction.&lt;/p&gt; &lt;p&gt;&lt;i&gt;Circle&lt;/i&gt; — a circular ring around a central axis; Size = ring radius; Rotation sets the axis.&lt;/p&gt; &lt;p&gt;&lt;i&gt;Square&lt;/i&gt; — a square ring; Size = half edge; Rotation sets orientation.&lt;/p&gt; &lt;p&gt;&lt;i&gt;Sphere&lt;/i&gt; — a spherical shell; Size = radius.&lt;/p&gt; &lt;p&gt;&lt;i&gt;Cube&lt;/i&gt; — a cubic shell; Size = half edge length.&lt;/p&gt; &lt;p&gt;Tip: Use Thickness to control falloff width, Visibility/Visibility size for reach, and set center/Relative center and Orbit rotation as needed. Effective when “Fake lights” is enabled.&lt;/p&gt; &lt;/body&gt;&lt;/html&gt;</string>
                     </property>
