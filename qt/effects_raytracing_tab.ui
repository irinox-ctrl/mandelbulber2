                </item>
                <item row="3" column="0">
                 <widget class="QLabel" name="label_349">
                  <property name="text">
                   <string>Number of passes:</string>
                  </property>
                 </widget>
                </item>
                <item row="3" column="1">
                 <widget class="MySpinBox" name="spinboxInt_DOF_number_of_passes">
                  <property name="sizePolicy">
                   <sizepolicy hsizetype="Minimum" vsizetype="Maximum">
